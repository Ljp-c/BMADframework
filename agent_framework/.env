# ===========================================
# AutoGen Framework Configuration
# ===========================================

# Disable Telemetry (Critical for avoiding timeouts in restricted networks)
OTEL_SDK_DISABLED=true

# API Configuration - Please configure with your actual API credentials
# Example for OpenAI:
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL_NAME=gpt-4-turbo

# Example for Custom API (like LongCat, DeepSeek, etc):
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.longcat.chat/openai
OPENAI_MODEL_NAME=LongCat-Flash-Thinking

# Running Mode: interactive | autogen | direct | architecture
RUN_MODE=interactive

# Phase Control (Optional)
# START_PHASE=phase-1
# END_PHASE=phase-3    