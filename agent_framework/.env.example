# ===========================================
# AutoGen 智能体对话框架配置文件
# ===========================================

# OpenAI API Key (必填)
# 如果使用其他模型商，请填入对应的 Key
OPENAI_API_KEY=sk-your-key-here

# Custom Model Configuration (可选)
# 如果使用其他模型（如 DeepSeek, Moonshot, Qwen 等），请配置以下两项：

# 1. API Base URL (例如 DeepSeek: https://api.deepseek.com/v1)
# OPENAI_API_BASE=https://api.deepseek.com/v1

# 2. Model Name (例如 deepseek-chat, moonshot-v1-8k)
# OPENAI_MODEL_NAME=deepseek-chat

# Proxy Configuration (可选)
# 如果您需要通过代理访问 API (例如访问 OpenAI)，请配置此项
# OPENAI_PROXY=http://127.0.0.1:7890

# ===========================================
# 运行模式配置
# ===========================================
# 可选值:
# - interactive: 交互模式 - 与用户进行实时对话（默认推荐）
# - autogen: 多智能体协作模式 - 自动执行任务流程
# - direct: 直接模式 - 单智能体直接调用
# - architecture: 架构验证模式 - 验证配置文件完整性

RUN_MODE=interactive

# ===========================================
# 阶段控制 (可选)
# 用于控制任务执行的起止阶段
# START_PHASE=phase-1
# END_PHASE=phase-3
