# OpenAI API Key (Required)
# 如果使用其他模型商，请填入对应的 Key
OPENAI_API_KEY=sk-your-key-here

# Custom Model Configuration (Optional)
# 如果使用其他模型（如 DeepSeek, Moonshot, Qwen 等），请配置以下两项：

# 1. API Base URL (例如 DeepSeek: https://api.deepseek.com/v1)
# OPENAI_API_BASE=https://api.deepseek.com/v1

# 2. Model Name (例如 deepseek-chat, moonshot-v1-8k)
# OPENAI_MODEL_NAME=deepseek-chat

# Proxy Configuration (Optional)
# 如果您需要通过代理访问 API (例如访问 OpenAI)，请配置此项
# OPENAI_PROXY=http://127.0.0.1:7890
