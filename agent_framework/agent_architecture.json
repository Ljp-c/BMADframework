{
  "version": "1.1",
  "project_docs_root": "project/docs",
  "interaction_mode": {
    "enabled": true,
    "user_participation": "active",
    "dialogue_flow": "collaborative",
    "feedback_enabled": true
  },
  "agents": [
    {
      "id": "analyst",
      "name": "Business Analyst",
      "persona_file": "project/.bmad/personas/analyst.md",
      "primary_outputs": [
        "project/docs/project-brief.md"
      ],
      "interaction_style": {
        "proactive_questions": true,
        "clarification_requests": true,
        "progress_updates": true
      }
    },
    {
      "id": "pm",
      "name": "Product Manager",
      "persona_file": "project/.bmad/personas/pm.md",
      "primary_outputs": [
        "project/docs/prd.md"
      ],
      "interaction_style": {
        "proactive_questions": true,
        "clarification_requests": true,
        "progress_updates": true
      }
    },
    {
      "id": "architect",
      "name": "System Architect",
      "persona_file": "project/.bmad/personas/architect.md",
      "primary_outputs": [
        "project/docs/architecture.md",
        "project/docs/tech-stack.md",
        "project/docs/data-models.md",
        "project/docs/api-reference.md",
        "project/docs/environment.md"
      ],
      "interaction_style": {
        "proactive_questions": true,
        "clarification_requests": true,
        "progress_updates": true
      }
    },
    {
      "id": "design-architect",
      "name": "Front-end / UX Architect",
      "persona_file": "project/.bmad/personas/design-architect.md",
      "primary_outputs": [
        "project/docs/front-end-architecture.md",
        "project/docs/component-specs.md"
      ],
      "interaction_style": {
        "proactive_questions": true,
        "clarification_requests": true,
        "progress_updates": true
      }
    },
    {
      "id": "po",
      "name": "Product Owner",
      "persona_file": "project/.bmad/personas/po.md",
      "primary_outputs": [
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ],
      "interaction_style": {
        "proactive_questions": true,
        "clarification_requests": true,
        "progress_updates": true
      }
    },
    {
      "id": "dev",
      "name": "Full-stack Developer",
      "persona_file": "project/.bmad/personas/dev.md",
      "primary_outputs": [
        "project/src"
      ],
      "interaction_style": {
        "proactive_questions": true,
        "clarification_requests": true,
        "progress_updates": true
      }
    },
    {
      "id": "qa",
      "name": "QA Test Expert",
      "persona_file": "project/.bmad/personas/qa.md",
      "primary_outputs": [
        "project/docs"
      ],
      "interaction_style": {
        "proactive_questions": true,
        "clarification_requests": true,
        "progress_updates": true
      }
    }
  ],
  "phases": [
    {
      "id": "phase-1",
      "name": "Project Brief",
      "owner": "analyst",
      "task_file": "project/.bmad/tasks/create-project-brief.md",
      "inputs": [],
      "outputs": [
        "project/docs/project-brief.md"
      ],
      "gates": [],
      "user_interaction_points": [
        "requirements_gathering",
        "scope_confirmation",
        "deliverable_review"
      ]
    },
    {
      "id": "phase-2",
      "name": "PRD",
      "owner": "pm",
      "task_file": "project/.bmad/tasks/create-prd.md",
      "inputs": [
        "project/docs/project-brief.md"
      ],
      "outputs": [
        "project/docs/prd.md"
      ],
      "gates": [
        "project/.bmad/checklists/prd-checklist.md"
      ],
      "user_interaction_points": [
        "feature_prioritization",
        "requirement_validation",
        "deliverable_review"
      ]
    },
    {
      "id": "phase-3",
      "name": "System Architecture",
      "owner": "architect",
      "task_file": "project/.bmad/tasks/create-architecture.md",
      "inputs": [
        "project/docs/prd.md"
      ],
      "outputs": [
        "project/docs/architecture.md",
        "project/docs/tech-stack.md",
        "project/docs/data-models.md",
        "project/docs/api-reference.md",
        "project/docs/environment.md"
      ],
      "gates": [
        "project/.bmad/checklists/architecture-checklist.md"
      ],
      "user_interaction_points": [
        "technology_discussion",
        "design_decisions",
        "deliverable_review"
      ]
    },
    {
      "id": "phase-4",
      "name": "Front-end Architecture",
      "owner": "design-architect",
      "task_file": "project/.bmad/tasks/create-front-end-architecture.md",
      "inputs": [
        "project/docs/prd.md",
        "project/docs/architecture.md"
      ],
      "outputs": [
        "project/docs/front-end-architecture.md",
        "project/docs/component-specs.md"
      ],
      "gates": [
        "project/.bmad/checklists/frontend-architecture-checklist.md"
      ],
      "user_interaction_points": [
        "ui_discussion",
        "component_design",
        "deliverable_review"
      ]
    },
    {
      "id": "phase-5",
      "name": "Stories",
      "owner": "po",
      "task_file": "project/.bmad/tasks/create-next-story.md",
      "inputs": [
        "project/docs/prd.md",
        "project/docs/architecture.md",
        "project/docs/front-end-architecture.md"
      ],
      "outputs": [
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ],
      "gates": [
        "project/.bmad/checklists/story-draft-checklist.md",
        "project/.bmad/checklists/story-ready-checklist.md"
      ],
      "user_interaction_points": [
        "story_creation",
        "acceptance_criteria",
        "deliverable_review"
      ]
    },
    {
      "id": "phase-6",
      "name": "Implementation",
      "owner": "dev",
      "task_file": null,
      "inputs": [
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ],
      "outputs": [
        "project/src"
      ],
      "gates": [],
      "user_interaction_points": [
        "implementation_questions",
        "code_review",
        "progress_updates"
      ]
    },
    {
      "id": "phase-7",
      "name": "Quality Assurance",
      "owner": "qa",
      "task_file": null,
      "inputs": [
        "project/src",
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ],
      "outputs": [
        "project/docs"
      ],
      "gates": [],
      "user_interaction_points": [
        "test_strategy",
        "bug_reports",
        "quality_signoff"
      ]
    }
  ],
  "handoffs": [
    {
      "from": "analyst",
      "to": "pm",
      "artifacts": [
        "project/docs/project-brief.md"
      ],
      "notification_message": "**Analyst**: 项目简报已完成，现在交给 PM 继续处理产品需求文档。"
    },
    {
      "from": "pm",
      "to": "architect",
      "artifacts": [
        "project/docs/prd.md"
      ],
      "notification_message": "**PM**: 产品需求文档已准备就绪，现在交给 Architect 进行系统架构设计。"
    },
    {
      "from": "architect",
      "to": "design-architect",
      "artifacts": [
        "project/docs/architecture.md",
        "project/docs/tech-stack.md",
        "project/docs/data-models.md",
        "project/docs/api-reference.md",
        "project/docs/environment.md"
      ],
      "notification_message": "**Architect**: 系统架构设计已完成，现在交给 Design Architect 进行前端架构设计。"
    },
    {
      "from": "design-architect",
      "to": "po",
      "artifacts": [
        "project/docs/front-end-architecture.md",
        "project/docs/component-specs.md"
      ],
      "notification_message": "**Design Architect**: 前端架构设计已完成，现在交给 PO 创建用户故事。"
    },
    {
      "from": "po",
      "to": "dev",
      "artifacts": [
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ],
      "notification_message": "**PO**: 用户故事已创建完成，现在交给 Dev 进行实现。"
    },
    {
      "from": "dev",
      "to": "qa",
      "artifacts": [
        "project/src"
      ],
      "notification_message": "**Dev**: 代码实现已完成，现在交给 QA 进行质量测试。"
    }
  ],
  "dialogue_templates": {
    "welcome": "欢迎使用智能体对话系统！我是您的项目助手，今天将由我和我的团队为您服务。",
    "handoff": "任务交接：{from_agent} -> {to_agent}\n交接内容: {artifacts}",
    "completion": "恭喜！{phase_name} 阶段已完成。{next_steps}",
    "clarification": "为了更好地为您服务，我需要确认一些信息：{questions}"
  }
}
