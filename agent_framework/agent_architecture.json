{
  "version": "1.0",
  "project_docs_root": "project/docs",
  "agents": [
    {
      "id": "analyst",
      "name": "Business Analyst",
      "persona_file": "project/.bmad/personas/analyst.md",
      "primary_outputs": [
        "project/docs/project-brief.md"
      ]
    },
    {
      "id": "pm",
      "name": "Product Manager",
      "persona_file": "project/.bmad/personas/pm.md",
      "primary_outputs": [
        "project/docs/prd.md"
      ]
    },
    {
      "id": "architect",
      "name": "System Architect",
      "persona_file": "project/.bmad/personas/architect.md",
      "primary_outputs": [
        "project/docs/architecture.md",
        "project/docs/tech-stack.md",
        "project/docs/data-models.md",
        "project/docs/api-reference.md",
        "project/docs/environment.md"
      ]
    },
    {
      "id": "design-architect",
      "name": "Front-end / UX Architect",
      "persona_file": "project/.bmad/personas/design-architect.md",
      "primary_outputs": [
        "project/docs/front-end-architecture.md",
        "project/docs/component-specs.md"
      ]
    },
    {
      "id": "po",
      "name": "Product Owner",
      "persona_file": "project/.bmad/personas/po.md",
      "primary_outputs": [
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ]
    },
    {
      "id": "dev",
      "name": "Full-stack Developer",
      "persona_file": "project/.bmad/personas/dev.md",
      "primary_outputs": [
        "project/src"
      ]
    },
    {
      "id": "qa",
      "name": "QA Test Expert",
      "persona_file": "project/.bmad/personas/qa.md",
      "primary_outputs": [
        "project/docs"
      ]
    }
  ],
  "phases": [
    {
      "id": "phase-1",
      "name": "Project Brief",
      "owner": "analyst",
      "task_file": "project/.bmad/tasks/create-project-brief.md",
      "inputs": [],
      "outputs": [
        "project/docs/project-brief.md"
      ],
      "gates": []
    },
    {
      "id": "phase-2",
      "name": "PRD",
      "owner": "pm",
      "task_file": "project/.bmad/tasks/create-prd.md",
      "inputs": [
        "project/docs/project-brief.md"
      ],
      "outputs": [
        "project/docs/prd.md"
      ],
      "gates": [
        "project/.bmad/checklists/prd-checklist.md"
      ]
    },
    {
      "id": "phase-3",
      "name": "System Architecture",
      "owner": "architect",
      "task_file": "project/.bmad/tasks/create-architecture.md",
      "inputs": [
        "project/docs/prd.md"
      ],
      "outputs": [
        "project/docs/architecture.md",
        "project/docs/tech-stack.md",
        "project/docs/data-models.md",
        "project/docs/api-reference.md",
        "project/docs/environment.md"
      ],
      "gates": [
        "project/.bmad/checklists/architecture-checklist.md"
      ]
    },
    {
      "id": "phase-4",
      "name": "Front-end Architecture",
      "owner": "design-architect",
      "task_file": "project/.bmad/tasks/create-front-end-architecture.md",
      "inputs": [
        "project/docs/prd.md",
        "project/docs/architecture.md"
      ],
      "outputs": [
        "project/docs/front-end-architecture.md",
        "project/docs/component-specs.md"
      ],
      "gates": [
        "project/.bmad/checklists/frontend-architecture-checklist.md"
      ]
    },
    {
      "id": "phase-5",
      "name": "Stories",
      "owner": "po",
      "task_file": "project/.bmad/tasks/create-next-story.md",
      "inputs": [
        "project/docs/prd.md",
        "project/docs/architecture.md",
        "project/docs/front-end-architecture.md"
      ],
      "outputs": [
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ],
      "gates": [
        "project/.bmad/checklists/story-draft-checklist.md",
        "project/.bmad/checklists/story-ready-checklist.md"
      ]
    },
    {
      "id": "phase-6",
      "name": "Implementation",
      "owner": "dev",
      "task_file": null,
      "inputs": [
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ],
      "outputs": [
        "project/src"
      ],
      "gates": []
    },
    {
      "id": "phase-7",
      "name": "Quality Assurance",
      "owner": "qa",
      "task_file": null,
      "inputs": [
        "project/src",
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ],
      "outputs": [
        "project/docs"
      ],
      "gates": []
    }
  ],
  "handoffs": [
    {
      "from": "analyst",
      "to": "pm",
      "artifacts": [
        "project/docs/project-brief.md"
      ]
    },
    {
      "from": "pm",
      "to": "architect",
      "artifacts": [
        "project/docs/prd.md"
      ]
    },
    {
      "from": "architect",
      "to": "design-architect",
      "artifacts": [
        "project/docs/architecture.md",
        "project/docs/tech-stack.md",
        "project/docs/data-models.md",
        "project/docs/api-reference.md",
        "project/docs/environment.md"
      ]
    },
    {
      "from": "design-architect",
      "to": "po",
      "artifacts": [
        "project/docs/front-end-architecture.md",
        "project/docs/component-specs.md"
      ]
    },
    {
      "from": "po",
      "to": "dev",
      "artifacts": [
        "project/docs/stories/epic-1/story-1.1.md",
        "project/docs/stories/epic-1/story-1.2.md",
        "project/docs/stories/epic-1/story-1.3.md",
        "project/docs/stories/epic-2/story-2.1.md",
        "project/docs/stories/epic-2/story-2.2.md"
      ]
    },
    {
      "from": "dev",
      "to": "qa",
      "artifacts": [
        "project/src"
      ]
    }
  ]
}
